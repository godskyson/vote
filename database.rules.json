{
  "rules": {
    "session": {
      ".read": true,
      ".write": "auth != null && auth.token.email === 'teacher@classvote.app'"
    },
    "votes": {
      ".read": true,
      ".write": "auth != null && auth.token.email === 'teacher@classvote.app' && !newData.exists()",
      "$round": {
        "$clientId": {
          ".write": "root.child('session/phase').val() === 'voting' && root.child('session/round').val() === $round && now <= root.child('session/endsAt').val()",
          ".validate": "newData.isString() && (newData.val() === 'yes' || newData.val() === 'no') && $clientId.length <= 64"
        }
      }
    }
  }
}
